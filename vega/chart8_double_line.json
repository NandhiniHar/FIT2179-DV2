{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Is Malaysia's Healthcare Workforce Growing Fast Enough? (2015 to 2022)",
    "subtitle": "Growth indexed to 2015 = 100. A value of 110 means 10% growth since 2015.",
    "fontSize": 20,
    "font": "sans-serif",
    "color": "#111111",
    "fontWeight": "bold",
    "anchor": "start",
    "subtitleFontSize": 14,
    "subtitleColor": "#555555",
    "subtitlePadding": 5
  },
  "width": 700,
  "height": 400,
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/NandhiniHar/FIT2179-DV2/refs/heads/main/data/population_malaysia_'12_'22.csv",
        "format": {"type": "csv", "parse": {"date": "date", "population": "number"}}
      },
      "transform": [
        {"filter": "datum.sex == 'both' && datum.age == 'overall' && datum.ethnicity == 'overall'"},
        {"filter": "year(datum.date) >= 2015 && year(datum.date) <= 2022"},
        {
          "aggregate": [{"op": "sum", "field": "population", "as": "total_population"}],
          "groupby": ["date"]
        },
        {"calculate": "datum.total_population * 1000", "as": "population_actual"},
        {
          "window": [{"op": "first_value", "field": "population_actual", "as": "base_pop"}],
          "sort": [{"field": "date", "order": "ascending"}],
          "frame": [null, null]
        },
        {"calculate": "(datum.population_actual / datum.base_pop) * 100", "as": "indexed"},
        {"calculate": "'Population'", "as": "series"}
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "point": {"filled": true, "size": 60}
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%Y",
            "labelAngle": 0,
            "grid": false,
            "tickCount": 8,
            "labelFontSize": 11,
            "domainColor": "#cccccc"
          }
        },
        "y": {
          "field": "indexed",
          "type": "quantitative",
          "title": "Growth Index (2015 = 100)",
          "scale": {"domain": [98, 132]},
          "axis": {
            "titleFontSize": 11,
            "titleColor": "#555555",
            "labelFontSize": 11,
            "labelColor": "#555555",
            "grid": true,
            "gridColor": "#e8e8e8",
            "gridDash": [3, 3],
            "domainColor": "#cccccc",
            "format": ".0f"
          }
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": ["Population", "Healthcare Staff"],
            "range": ["#FF6E00", "#8BC34A"]
          }
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Year", "format": "%Y"},
          {"field": "population_actual", "type": "quantitative", "title": "Population", "format": ",.0f"},
          {"field": "indexed", "type": "quantitative", "title": "Index (2015=100)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/NandhiniHar/FIT2179-DV2/refs/heads/main/data/healthcare_staff_only_Malaysia.csv",
        "format": {"type": "csv", "parse": {"date": "date", "staff": "number"}}
      },
      "transform": [
        {"filter": "datum.type == 'all' && year(datum.date) >= 2015 && year(datum.date) <= 2022"},
        {
          "window": [{"op": "first_value", "field": "staff", "as": "base_staff"}],
          "sort": [{"field": "date", "order": "ascending"}],
          "frame": [null, null]
        },
        {"calculate": "(datum.staff / datum.base_staff) * 100", "as": "indexed"},
        {"calculate": "'Healthcare Staff'", "as": "series"}
      ],
      "mark": {
        "type": "line",
        "strokeDash": [6, 3],
        "strokeWidth": 2.5,
        "point": {"filled": true, "size": 60}
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "axis": {"format": "%Y", "labelAngle": 0, "grid": false}
        },
        "y": {
          "field": "indexed",
          "type": "quantitative",
          "scale": {"domain": [98, 132]}
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": ["Population", "Healthcare Staff"],
            "range": ["#FF6E00", "#8BC34A"]
          },
          "legend": {
            "title": null,
            "orient": "right",
            "direction": "vertical",
            "labelFontSize": 11,
            "symbolType": "stroke",
            "symbolStrokeWidth": 15,
            "symbolSize": 250,
            "padding": 8
          }
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "title": "Year", "format": "%Y"},
          {"field": "staff", "type": "quantitative", "title": "Total Staff", "format": ","},
          {"field": "indexed", "type": "quantitative", "title": "Index (2015=100)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {"values": [{}]},
      "mark": {"type": "rule", "color": "#aaaaaa", "strokeWidth": 1, "strokeDash": [2, 2]},
      "encoding": {"y": {"datum": 100}}
    },
    {
      "data": {"values": [{"x": "2015-06-01", "y": 100}]},
      "mark": {
        "type": "text",
        "align": "left",
        "dx": -29,
        "dy": 10,
        "fontSize": 11,
        "color": "#999999",
        "fontStyle": "italic",
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {"field": "x", "type": "temporal"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"value": "Baseline (2015 = 100)"}
      }
    },
    {
      "data": {"values": [{"start": "2019-01-01", "end": "2020-01-01"}]},
      "mark": {"type": "rect", "opacity": 0.06, "color": "#999999"},
      "encoding": {
        "x": {"field": "start", "type": "temporal"},
        "x2": {"field": "end"}
      }
    },
    {
      "data": {"values": [{"x": "2020-01-01"}]},
      "mark": {"type": "rule", "color": "#999999", "strokeDash": [4, 3], "strokeWidth": 1},
      "encoding": {"x": {"field": "x", "type": "temporal"}}
    },
    {
      "data": {"values": [{"x": "2020-01-01", "y": 128}]},
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11,
        "color": "#555555",
        "fontWeight": "bold",
        "lineBreak": "\n"
      },
      "encoding": {
        "x": {"field": "x", "type": "temporal"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"value": "COVID-19 slows\nhiring growth."}
      }
    },
    {
      "data": {"values": [{"x": "2020-04-01", "y": 118}]},
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11,
        "color": "#555555",
        "fontWeight": "bold",
        "lineBreak": "\n"
      },
      "encoding": {
        "x": {"field": "x", "type": "temporal"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"value": "Workforce growing faster than\npopulation indicates improving\ncare access."}
      }
    },
    {
      "data": {"values": [{"x": "2019-01-01"}]},
      "mark": {"type": "rule", "color": "#999999", "strokeDash": [4, 3], "strokeWidth": 1},
      "encoding": {"x": {"field": "x", "type": "temporal"}}
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {"domainColor": "#cccccc"}
  }
}
