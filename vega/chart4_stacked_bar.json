{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "MOH Hospitals Dominate Bed Provision Across All States (2022)",
    "fontSize": 20,
    "font": "sans-serif",
    "color": "#111111",
    "fontWeight": "bold",
    "anchor": "start",
    "subtitle": "Share of public hospital beds by hospital type - each bar sums to 100%.",
    "subtitleFontSize": 14,
    "subtitleColor": "#555555",
    "subtitlePadding": 5
  },
  "width": 700,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/NandhiniHar/FIT2179-DV2/refs/heads/main/data/hospital_beds.csv",
    "format": {
      "type": "csv",
      "parse": { "beds": "number" }
    }
  },
  "transform": [
    { "filter": "year(toDate(datum.date)) == 2022" },
    { "filter": "datum.state != 'Malaysia'" },
    { "filter": "datum.district == 'All Districts'" },
    { "filter": "datum.type != 'all'" },
    {
      "calculate": "datum.type == 'hospital_moh' ? 'MOH Hospital' : datum.type == 'hospital_non_moh' ? 'Non-MOH Hospital' : 'Special Medical Institution'",
      "as": "type_label"
    },
    {
      "calculate": "datum.type == 'hospital_moh' ? 1 : datum.type == 'hospital_non_moh' ? 2 : 3",
      "as": "sort_order"
    },
    {
      "joinaggregate": [
        { "field": "beds", "op": "sum", "as": "state_total" }
      ],
      "groupby": ["state"]
    },
    {
      "calculate": "datum.beds / datum.state_total",
      "as": "share"
    }
  ],
  "layer": [
    {
      "mark": { "type": "bar" },
      "encoding": {
        "x": {
          "field": "beds",
          "type": "quantitative",
          "title": "Share of Hospital Beds (%)",
          "stack": "normalize",
          "axis": {
            "format": "%",
            "labelAngle": 0,
            "ticks": false,
            "domain": false,
            "gridColor": "#e0e0e0",
            "gridDash": [3, 3]
          }
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "title": null,
          "axis": {
            "labelFontSize": 11,
            "labelColor": "#555555",
            "ticks": false,
            "domain": false
          }
        },
        "color": {
          "field": "type_label",
          "type": "nominal",
          "title": "Hospital Type",
          "sort": { "field": "sort_order", "op": "min" },
          "scale": {
            "domain": ["MOH Hospital", "Non-MOH Hospital", "Special Medical Institution"],
            "range": ["#7C287D", "#FBF873", "#008080"]
          },
          "legend": {
            "orient": "right",
            "direction": "vertical",
            "titleFontSize": 11,
            "labelFontSize": 11,
            "symbolType": "square",
            "symbolSize": 260,
            "symbolStrokeWidth": 0,
            "labelLimit": 1000,
            "rowPadding": 8,
            "columnPadding": 12,
            "padding": 6
          }
        },
        "order": {
          "field": "sort_order",
          "type": "quantitative"
        },
        "tooltip": [
          { "field": "state", "type": "nominal", "title": "State" },
          { "field": "type_label", "type": "nominal", "title": "Hospital Type" },
          { "field": "beds", "type": "quantitative", "title": "Beds", "format": "," },
          { "field": "share", "type": "quantitative", "title": "Share of State Beds", "format": ".1%" }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "state": "W.P. Kuala Lumpur",
            "x": 0.5,
            "t": "KL is the only state where\nMOH is a minority-\nprivate (Non-MOH) hospitals\nsupply half its beds."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 355,
        "dy": -17,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333333",
        "lineBreak": "\n"
      },
      "encoding": {
        "x": { "field": "x", "type": "quantitative" },
        "y": { "field": "state", "type": "nominal" },
        "text": { "field": "t" }
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "axis": { "grid": false }
  }
}
