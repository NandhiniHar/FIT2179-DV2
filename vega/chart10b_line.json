{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Organ Pledges in Malaysia: 2012 to 2022",
    "fontSize": 20,
    "font": "sans-serif",
    "color": "#111111",
    "fontWeight": "bold",
    "anchor": "start",
    "subtitle": "National organ pledges rose to a 2015 peak, collapsed during the 2020 pandemic, then rebounded to a record high in 2022",
    "subtitleFontSize": 13,
    "subtitleColor": "#555555",
    "subtitlePadding": 4
  },

  "width": 700,
  "height": 380,

  "data": {
    "url": "https://raw.githubusercontent.com/NandhiniHar/FIT2179-DV2/refs/heads/main/data/pledges_yearly.csv"
  },

  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0,
        "titleFont": "sans-serif",
        "titleFontSize": 11,
        "titleColor": "#555555",
        "labelFont": "sans-serif",
        "labelFontSize": 10,
        "labelColor": "#555555"
      }
    },
    "y": {
      "field": "Pledges",
      "type": "quantitative",
      "title": "Total Organ Pledges (All States)",
      "axis": {
        "format": ",.0f",
        "titleFont": "sans-serif",
        "titleFontSize": 11,
        "titleColor": "#555555",
        "labelFont": "sans-serif",
        "labelFontSize": 10,
        "labelColor": "#555555",
        "grid": true,
        "gridColor": "#eeeeee"
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "color": "#8c1822",
        "point": {
          "filled": true,
          "fill": "#8c1822",
          "size": 60
        }
      },
      "encoding": {
        "tooltip": [
          {"field": "Year", "type": "ordinal", "title": "Year"},
          {"field": "Pledges", "type": "quantitative", "title": "Total Pledges", "format": ","}
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -12,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#8c1822"
      },
      "transform": [
        {"filter": "datum.Year == 2012 || datum.Year == 2022 || datum.Year == 2015"}
      ],
      "encoding": {
        "text": {"field": "Pledges", "type": "quantitative", "format": ","}
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "center",
        "dx": 10,
        "dy": -17,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#8c1822"
      },
      "transform": [
        {"filter": "datum.Year == 2020"}
      ],
      "encoding": {
        "text": {"field": "Pledges", "type": "quantitative", "format": ","}
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 25,
        "dy": -27,
        "fontSize": 11,
        "fontStyle": "italic",
        "lineBreak": "\n",
        "color": "#555555"
      },
      "transform": [{"filter": "datum.Year == 2015"}],
      "encoding": {
        "text": {"value": "2015 peak in pledges,\nlikely strong awareness drives"}
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -20,
        "dy": -15,
        "fontSize": 11,
        "fontStyle": "italic",
        "lineBreak": "\n",
        "color": "#555555"
      },
      "transform": [{"filter": "datum.Year == 2020"}],
      "encoding": {
        "text": {"value": "Sharp drop in 2020,\nlikely COVID-19 disruption"}
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -25,
        "dy": 19,
        "fontSize": 11,
        "fontStyle": "italic",
        "lineBreak": "\n",
        "color": "#555555"
      },
      "transform": [{"filter": "datum.Year == 2022"}],
      "encoding": {
        "text": {"value": "Strong rebound in 2022,\nrecord high for the period"}
      }
    }
  ],

  "config": {
    "background": "white",
    "view": {"stroke": null},
    "axis": {
      "domain": true,
      "domainColor": "#999999",
      "domainWidth": 1.5
    }
  }
}