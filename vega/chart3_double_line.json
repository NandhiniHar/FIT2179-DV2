{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Do Hospital Beds Keep Up with Population Size?",
    "fontSize": 20,
    "font": "sans-serif",
    "color": "#111111",
    "fontWeight": "bold",
    "anchor": "start",
    "subtitle": "Both lines indexed to 100 at their first year, so equal slopes mean equal growth. Population from 2012; beds data begins in 2015.",
    "subtitleFontSize": 14,
    "subtitleColor": "#555555",
    "subtitlePadding": 5
  },
  "width": 700,
  "height": 400,
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/NandhiniHar/FIT2179-DV2/refs/heads/main/data/population_malaysia_'12_'22.csv"
      },
      "transform": [
        {
          "filter": "datum.sex == 'both' && datum.age == 'overall' && datum.ethnicity == 'overall'"
        },
        {
          "calculate": "toNumber(datum.population)",
          "as": "pop_num"
        },
        {
          "aggregate": [{ "op": "sum", "field": "pop_num", "as": "total_pop" }],
          "groupby": ["date"]
        },
        {
          "calculate": "datum.total_pop * 1000",
          "as": "population_actual"
        },
        {
          "calculate": "year(datum.date)",
          "as": "yr"
        },
        { "filter": "datum.yr <= 2022" },
        {
          "window": [{ "op": "first_value", "field": "total_pop", "as": "base_val" }],
          "sort": [{ "field": "yr", "order": "ascending" }],
          "frame": [null, null]
        },
        {
          "calculate": "datum.total_pop / datum.base_val * 100",
          "as": "index"
        },
        {
          "calculate": "'Population'",
          "as": "series"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#0072B2",
        "strokeWidth": 2.5,
        "point": { "filled": true, "size": 55, "color": "#0072B2" }
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": "%Y",
            "labelAngle": 0,
            "grid": false,
            "tickCount": 11,
            "labelFontSize": 11
          }
        },
        "y": {
          "field": "index",
          "type": "quantitative",
          "title": "Indexed Value (first year = 100)",
          "scale": { "zero": false, "domainMin": 98 },
          "axis": {
            "grid": true,
            "gridColor": "#e8e8e8",
            "gridDash": [3, 3],
            "labelFontSize": 11,
            "titleFontSize": 11
          }
        },
        "color": {
          "field": "series",
          "type": "nominal",
          "scale": {
            "domain": ["Population", "Hospital beds"],
            "range": ["#0072B2", "#E69F00"]
          },
          "legend": {
            "title": null,
            "orient": "right",
            "direction": "vertical",
            "labelFontSize": 11,
            "labelFontWeight": "bold",
            "symbolStrokeWidth": 4,
            "padding": 6
          }
        },
        "tooltip": [
          { "field": "date", "type": "temporal", "title": "Year", "format": "%Y" },
          { "field": "population_actual", "type": "quantitative", "title": "Population", "format": ",.0f" },
          { "field": "index", "type": "quantitative", "title": "Index (2012=100)", "format": ".1f" }
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/NandhiniHar/FIT2179-DV2/refs/heads/main/data/hospital_beds_only _Malaysia.csv"
      },
      "transform": [
        { "filter": "datum.state == 'Malaysia' && datum.type == 'all'" },
        {
          "calculate": "toNumber(datum.beds)",
          "as": "beds_num"
        },
        {
          "calculate": "year(datum.date)",
          "as": "yr"
        },
        {
          "window": [{ "op": "first_value", "field": "beds_num", "as": "base_val" }],
          "sort": [{ "field": "yr", "order": "ascending" }],
          "frame": [null, null]
        },
        {
          "calculate": "datum.beds_num / datum.base_val * 100",
          "as": "index"
        },
        {
          "calculate": "'Hospital beds'",
          "as": "series"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#E69F00",
        "strokeWidth": 2.5,
        "strokeDash": [6, 3],
        "point": { "filled": true, "size": 55, "color": "#E69F00" }
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "index",
          "type": "quantitative"
        },
        "color": {
          "field": "series",
          "type": "nominal"
        },
        "tooltip": [
          { "field": "date", "type": "temporal", "title": "Year", "format": "%Y" },
          { "field": "beds_num", "type": "quantitative", "title": "Total Beds", "format": "," },
          { "field": "index", "type": "quantitative", "title": "Index (2015=100)", "format": ".1f" }
        ]
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "axis": { "domainColor": "#cccccc" }
  }
}
