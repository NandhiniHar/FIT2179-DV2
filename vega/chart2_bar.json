{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Which States Have the Most Public Hospital Beds? (2022)",
    "fontSize": 20,
    "font": "sans-serif",
    "color": "#111111",
    "fontWeight": "bold",
    "anchor": "start",
    "subtitle": "Selangor leads the count, but some smaller states surprise.",
    "subtitleFontSize": 14,
    "subtitleColor": "#555555",
    "subtitlePadding": 5
  },
  "width": 700,
  "height": 400,
  "data": {
    "url": "https://raw.githubusercontent.com/NandhiniHar/FIT2179-DV2/refs/heads/main/data/hospital_beds.csv",
    "format": {"type": "csv", "parse": {"beds": "number"}}
  },
  "transform": [
    {"filter": "datum.district == 'All Districts'"},
    {"filter": "datum.state != 'Malaysia'"},
    {"filter": "datum.type == 'all'"},
    {"filter": "datum.date == '2022-01-01'"}
  ],
  "layer": [
    {
      "mark": {"type": "bar"},
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": {"field": "beds", "op": "max", "order": "descending"},
          "title": null,
          "axis": {
            "labelFont": "sans-serif",
            "labelFontSize": 11,
            "labelColor": "#555555"
          }
        },
        "x": {
          "field": "beds",
          "type": "quantitative",
          "title": "Total Hospital Beds",
          "scale": {"zero": true},
          "axis": {
            "titleFont": "sans-serif",
            "titleFontSize": 11,
            "titleColor": "#555555",
            "labelFont": "sans-serif",
            "labelFontSize": 11,
            "labelColor": "#555555",
            "grid": false
          }
        },
        "color": {
          "condition": [
            {"test": "datum.state == 'Perak'", "value": "#1f4e79"},
            {"test": "datum.state == 'W.P. Kuala Lumpur'", "value": "#1f4e79"}
          ],
          "value": "#cfe2f3"
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "beds", "type": "quantitative", "title": "Number of Beds", "format": ","}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 11,
        "fontWeight": "bold",
        "lineBreak": "\n"
      },
      "transform": [{"filter": "datum.state == 'Perak'"}],
      "encoding": {
        "y": {"field": "state", "type": "nominal", "sort": {"field": "beds", "op": "max", "order": "descending"}},
        "x": {"field": "beds", "type": "quantitative"},
        "text": {"value": "Ranks 2nd in beds,\nbut only 7th in population"},
        "color": {"value": "#1f4e79"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 11,
        "fontWeight": "bold",
        "lineBreak": "\n"
      },
      "transform": [{"filter": "datum.state == 'W.P. Kuala Lumpur'"}],
      "encoding": {
        "y": {"field": "state", "type": "nominal", "sort": {"field": "beds", "op": "max", "order": "descending"}},
        "x": {"field": "beds", "type": "quantitative"},
        "text": {"value": "Small federal territory,\ndisproportionately high bed count"},
        "color": {"value": "#1f4e79"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {"domainColor": "#cccccc"}
  }
}
